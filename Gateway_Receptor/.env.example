# Broker MQTT (WSS detrás de Cloudflare)
MQTT_HOST=mqtt.ralcivardev.com
MQTT_PORT=443
MQTT_WS_PATH=/mqtt
MQTT_USER=
MQTT_PASS=

# Tópicos y estado del gateway
MQTT_TOPIC_BASE=sensores
MQTT_STATUS_TOPIC=sensores/gateway/estado
ESTADO_CADA_S=60
ALERTA_SIN_PAQUETES_S=300
NODO_INACTIVO_S=60
MQTT_COLA_MAX=100000

# Opcional: por defecto se usa el hostname de la Raspberry
# GATEWAY_ID=server-pf
